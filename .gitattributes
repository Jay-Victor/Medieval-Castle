# normalise line endings
* text=auto eol=lf

# windows launchers need CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# binaries
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.glb binary
*.gltf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.mp4 binary
*.mp3 binary
*.wav binary
*.onnx binary
*.bin binary

pnpm-lock.yaml linguist-generated=true
